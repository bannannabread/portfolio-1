---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const channels = [
  { label: 'Email', value: 'meganmae.jacob@gmail.com', href: 'mailto:meganmae.jacob@gmail.com' },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/meganmaejacob',
    href: 'https://www.linkedin.com/in/meganmaejacob/',
  },
  { label: 'GitHub', value: 'github.com/bannannabread', href: 'https://github.com/bannannabread' },
];

const [primary, ...secondary] = channels;
---

<Layout
  title="Contact — Megan"
  description="Get in touch with Megan about design roles and collaborations."
>
  <SiteNav />

  <main id="main-content">
    <section class="intro">
      <div class="wrap">
        <h1>Let&rsquo;s talk about the <span class="accent-word">role</span>.</h1>
        <p class="lede">
          The fastest way to reach me is email &mdash; I read and reply to
          every message.
        </p>
      </div>
    </section>

    <section class="channels">
      <div class="wrap">
        <a class="primary-channel" href={primary.href}>
          <span class="primary-channel__text">
            <span class="primary-channel__label">{primary.label}</span>
            <span class="primary-channel__value">{primary.value}</span>
          </span>
          <span class="primary-channel__arrow" aria-hidden="true">&rarr;</span>
        </a>

        <ul class="secondary-channels">
          {
            secondary.map((channel) => (
              <li>
                <a href={channel.href} rel="me noopener" target="_blank">
                  <span class="label">{channel.label}</span>
                  <span class="value">{channel.value}</span>
                  <span class="arrow" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .intro {
    padding-block: var(--space-6) var(--space-5);
  }

  .accent-word {
    color: var(--accent);
  }

  .lede {
    margin-top: var(--space-3);
    font-size: 1.1875rem;
    color: var(--ink-soft);
    max-width: 48ch;
  }

  .channels {
    padding-block: var(--space-5) var(--space-6);
  }

  .primary-channel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
    max-width: 40rem;
    padding: 1.5rem 2rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--ground);
    text-decoration: none;
    transition: background 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }

  .primary-channel:hover {
    background: var(--ink);
    color: var(--ground);
    transform: translateY(-0.1rem);
  }

  .primary-channel__text {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .primary-channel__label {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-variation-settings: 'opsz' 40, 'SOFT' 35;
  }

  .primary-channel__value {
    font-size: 0.9375rem;
    color: var(--accent-tint);
  }

  .primary-channel__arrow {
    font-size: 1.5rem;
    flex-shrink: 0;
    transition: transform 0.2s var(--ease-out);
  }

  .primary-channel:hover .primary-channel__arrow {
    transform: translateX(0.25em);
  }

  .secondary-channels {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    max-width: 40rem;
  }

  .secondary-channels a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-2);
    text-decoration: none;
    color: var(--ink-faint);
    transition: color 0.2s var(--ease-out);
  }

  .secondary-channels a:hover {
    color: var(--accent);
  }

  .label {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-variation-settings: 'opsz' 40, 'SOFT' 35;
  }

  .value {
    font-size: 0.9375rem;
    flex-shrink: 0;
  }

  .secondary-channels .arrow {
    font-size: 1rem;
    flex-shrink: 0;
    transition: transform 0.2s var(--ease-out);
  }

  .secondary-channels a:hover .arrow {
    transform: translateX(0.2em);
  }

  @media (max-width: 640px) {
    .primary-channel {
      padding: 1.25rem 1.5rem;
    }

    .primary-channel__label {
      font-size: 1.5rem;
    }
  }
</style>
