---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const channels = [
  { label: 'Email', value: 'megan@example.com', href: 'mailto:megan@example.com' },
  { label: 'LinkedIn', value: 'linkedin.com/in/megan', href: 'https://linkedin.com' },
  { label: 'GitHub', value: 'github.com/megan', href: 'https://github.com' },
];
---

<Layout
  title="Contact — Megan"
  description="Get in touch with Megan about design roles and collaborations."
>
  <SiteNav />

  <main>
    <section class="intro">
      <div class="wrap">
        <h1>Let&rsquo;s talk about the role.</h1>
        <p class="lede">
          The fastest way to reach me is email &mdash; I read and reply to
          every message.
        </p>
      </div>
    </section>

    <section class="channels">
      <div class="wrap">
        <ul>
          {
            channels.map((channel) => (
              <li>
                <a href={channel.href} rel={channel.href.startsWith('http') ? 'me noopener' : undefined} target={channel.href.startsWith('http') ? '_blank' : undefined}>
                  <span class="label">{channel.label}</span>
                  <span class="value">{channel.value}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .intro {
    padding-block: var(--space-6) var(--space-5);
  }

  .lede {
    margin-top: var(--space-3);
    font-size: 1.1875rem;
    color: var(--ink-soft);
    max-width: 48ch;
  }

  .channels {
    padding-block: var(--space-5) var(--space-6);
  }

  .channels ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    max-width: 40rem;
  }

  .channels a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-top: 1px solid var(--ground-deep);
    text-decoration: none;
    color: var(--ink);
    transition: color 0.2s var(--ease-out);
  }

  .channels li:last-child a {
    border-bottom: 1px solid var(--ground-deep);
  }

  .channels a:hover {
    color: var(--accent);
  }

  .label {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-variation-settings: 'opsz' 40, 'SOFT' 35;
  }

  .value {
    font-size: 0.9375rem;
    color: var(--ink-faint);
  }

  .channels a:hover .value {
    color: var(--accent-soft);
  }
</style>
