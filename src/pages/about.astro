---
import { Image } from 'astro:assets';
import '@fontsource/homemade-apple';
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

import art1 from '../assets/about/art-photos/art-1.jpg';
import art2 from '../assets/about/art-photos/art-2.jpg';
import art3 from '../assets/about/art-photos/art-3.jpg';
import mentorship1 from '../assets/about/mentorship-photos/mentorship-1.jpg';
import mentorship2 from '../assets/about/mentorship-photos/mentorship-2.jpg';
import mentorship3 from '../assets/about/mentorship-photos/mentorship-3.png';
import sports1 from '../assets/about/sportsphoto/sports-1.jpg';
import sports2 from '../assets/about/sportsphoto/sports-2.jpg';
import sports3 from '../assets/about/sportsphoto/sports-3.jpg';

const funCategories = [
  { label: 'Art', photos: [art1, art2, art3] },
  { label: 'Mentorship & Teaching', photos: [mentorship1, mentorship2, mentorship3] },
  { label: 'Sports & Weightlifting', photos: [sports1, sports2, sports3] },
];
---

<Layout
  title="About — Megan"
  description="How Megan approaches product design, from research through shipped code."
>
  <SiteNav />

  <main id="main-content">
    <section class="intro">
      <div class="wrap">
        <h1>
          I bridge the gap between human-centered design and the code that brings it to life<span class="period">.</span>
          <span class="hand" aria-hidden="true">built with care</span>
        </h1>
        <p class="lede">
          I'm a CS major at UIUC bridging the gap between design intuition
          and technical execution. I bring both Figma files and codebases to
          life, making sure every design survives real-world engineering
          constraints.
        </p>
        <p class="status">
          <span class="status__dot" aria-hidden="true"></span>
          Currently representing Google as a Student Ambassador, bringing Gemini and AI initiatives to campus.
        </p>
      </div>
    </section>

    <section class="principles">
      <div class="wrap">
        <h2 class="visually-hidden">How I work</h2>
        <ol class="principle-list">
          <li>
            <h3>Architecture Before Aesthetics</h3>
            <p>
              Visual polish means very little without strong underlying
              structure. I prioritize mapping intuitive user flows,
              stripping away complexity, and solving core logic before
              focusing on visual UI styling.
            </p>
          </li>
          <li>
            <h3>Clarity Through Teaching</h3>
            <p>
              If you can't explain a design decision simply, it isn't
              ready. Leading UI workshops and mentoring students keeps my
              communication sharp and my design thinking intentional.
            </p>
          </li>
          <li>
            <h3>Continuous Learning</h3>
            <p>
              Whether I'm teaching a design workshop or diving into HCI
              research, I'm always refining how humans interact with
              technology.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <section class="fun">
      <div class="wrap">
        <h2>Outside of code</h2>
        <p class="fun-lede italic-serif">
          Volleyball player, digital artist, avid baker, boba enthusiast,
          and travel explorer.
        </p>
        <div class="fun-grid">
          {
            funCategories.map((category) => (
              <div class="fun-category">
                <h3>{category.label}</h3>
                <div class="fun-slots">
                  {category.photos.map((photo) => (
                    <div class="fun-slot">
                      <Image src={photo} alt="" width={480} class="fun-photo" />
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="wrap cta-band__inner">
        <p class="italic-serif">Want the full story &mdash; background, tools, résumé?</p>
        <a class="cta" href="/contact">Get in touch</a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .intro {
    padding-block: var(--space-6) var(--space-5);
  }

  h1 {
    position: relative;
    max-width: 26ch;
  }

  .period {
    color: var(--accent);
  }

  .hand {
    display: block;
    font-family: 'Homemade Apple', cursive;
    font-size: 1.5rem;
    line-height: 1.6;
    color: var(--accent);
    transform: rotate(-4deg);
    margin-top: 0.75rem;
    margin-left: 0.25rem;
    padding-bottom: 2rem;
  }

  .lede {
    margin-top: var(--space-3);
    font-size: 1.1875rem;
    color: var(--ink-soft);
    max-width: 56ch;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-3);
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .status__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .principles {
    padding-block: var(--space-5);
  }

  .principle-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .principle-list li {
    padding-top: var(--space-3);
    border-top: 1px solid var(--ground-deep);
  }

  .principle-list h3 {
    max-width: none;
  }

  .principle-list p {
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }

  .fun {
    padding-block: var(--space-5);
    border-top: 1px solid var(--ground-deep);
  }

  .fun-lede {
    margin-top: var(--space-2);
    font-size: 1.0625rem;
    color: var(--ink-soft);
    max-width: 56ch;
  }

  .fun-grid {
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-5);
  }

  .fun-category h3 {
    max-width: none;
  }

  .fun-slots {
    margin-top: var(--space-2);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }

  .fun-slot {
    aspect-ratio: 1;
    border-radius: 0.75rem;
    overflow: hidden;
    background: var(--ground-alt);
  }

  .fun-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-band {
    background: var(--ground-alt);
    padding-block: var(--space-5);
    margin-top: var(--space-5);
  }

  .cta-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .cta-band p {
    font-size: 1.375rem;
  }

  @media (min-width: 900px) {
    .principle-list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }

    .fun-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5) var(--space-5);
    }
  }
</style>
