---
import '@fontsource/homemade-apple';
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const funCategories = [
  { label: 'Art', slots: 3 },
  { label: 'Mentorship & Teaching', slots: 3 },
  { label: 'Sports & Weightlifting', slots: 3 },
  { label: 'Travel', slots: 3 },
];
---

<Layout
  title="About — Megan"
  description="How Megan approaches product design, from research through shipped code."
>
  <SiteNav />

  <main>
    <section class="intro">
      <div class="wrap">
        <h1>
          I design the whole path from problem to shipped product<span class="period">.</span>
          <span class="hand" aria-hidden="true">for real</span>
        </h1>
        <p class="lede">
          I'm a product designer who also writes the code that ships my
          designs. That means every decision I make already has to survive
          contact with a real interface, real data, and real constraints
          &mdash; not just a comp.
        </p>
        <p class="status">
          <span class="status__dot" aria-hidden="true"></span>
          Currently a Student Ambassador for Google, working to bring Gemini to campus.
        </p>
      </div>
    </section>

    <section class="principles">
      <div class="wrap">
        <h2 class="visually-hidden">How I work</h2>
        <ol class="principle-list">
          <li>
            <h3>Start from the reasoning, not the layout.</h3>
            <p>
              A screen is the last artifact of a decision, not the decision
              itself. I'd rather show the messy middle &mdash; the constraint
              that ruled something out, the option that lost on evidence
              &mdash; than only the polished result.
            </p>
          </li>
          <li>
            <h3>Ship it, don't just spec it.</h3>
            <p>
              Being able to build what I design keeps my ideas honest. It
              also means handoff isn't a translation step where nuance gets
              lost.
            </p>
          </li>
          <li>
            <h3>Evidence over opinion.</h3>
            <p>
              Research and real usage settle arguments that taste
              can't. When I don't have evidence yet, I say so.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <section class="fun">
      <div class="wrap">
        <h2>Outside of code</h2>
        <p class="fun-lede italic-serif">
          I make art, mentor and teach, lift and play sports, and travel
          whenever I can. Real photos going here as I add them &mdash; for
          now, these are the slots waiting to be filled.
        </p>
        <div class="fun-grid">
          {
            funCategories.map((category) => (
              <div class="fun-category">
                <h3>{category.label}</h3>
                <div class="fun-slots">
                  {Array.from({ length: category.slots }).map(() => (
                    <div class="fun-slot" aria-hidden="true" />
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="wrap cta-band__inner">
        <p class="italic-serif">Want the full story &mdash; background, tools, résumé?</p>
        <a class="cta" href="/contact">Get in touch</a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .intro {
    padding-block: var(--space-6) var(--space-5);
  }

  h1 {
    position: relative;
    max-width: 26ch;
  }

  .period {
    color: var(--accent);
  }

  .hand {
    display: block;
    font-family: 'Homemade Apple', cursive;
    font-size: 1.5rem;
    line-height: 1.6;
    color: var(--accent);
    transform: rotate(-4deg);
    margin-top: 0.75rem;
    margin-left: 0.25rem;
    padding-bottom: 2rem;
  }

  .lede {
    margin-top: var(--space-3);
    font-size: 1.1875rem;
    color: var(--ink-soft);
    max-width: 56ch;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-3);
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .status__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .principles {
    padding-block: var(--space-5);
  }

  .principle-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .principle-list li {
    padding-top: var(--space-3);
    border-top: 1px solid var(--ground-deep);
  }

  .principle-list h3 {
    max-width: none;
  }

  .principle-list p {
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }

  .fun {
    padding-block: var(--space-5);
    border-top: 1px solid var(--ground-deep);
  }

  .fun-lede {
    margin-top: var(--space-2);
    font-size: 1.0625rem;
    color: var(--ink-soft);
    max-width: 56ch;
  }

  .fun-grid {
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-5);
  }

  .fun-category h3 {
    max-width: none;
  }

  .fun-slots {
    margin-top: var(--space-2);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }

  .fun-slot {
    aspect-ratio: 1;
    border-radius: 0.75rem;
    border: 1.5px dashed var(--ink-faint);
    background: transparent;
    opacity: 0.55;
  }

  .cta-band {
    background: var(--ground-alt);
    padding-block: var(--space-5);
    margin-top: var(--space-5);
  }

  .cta-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .cta-band p {
    font-size: 1.375rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--ground);
    text-decoration: none;
    font-size: 0.9375rem;
    white-space: nowrap;
    transition: background 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }

  .cta:hover {
    background: var(--ink);
    transform: translateY(-0.1rem);
  }

  @media (min-width: 900px) {
    .principle-list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }

    .fun-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5) var(--space-5);
    }
  }
</style>
