---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<Layout
  title="Megan — Product designer who engineers"
  description="Product design portfolio: case studies from research through shipped code."
>
  <SiteNav />

  <main>
    <Hero />

    <section class="work-index">
      <div class="wrap">
        <h2>Selected work</h2>
        <ul class="grid">
          {
            projects.map((project, index) => (
              <ProjectCard
                href={project.comingSoon ? undefined : `/work/${project.slug}`}
                gradient={project.gradient}
                caption={project.caption}
                tags={project.tags}
                comingSoon={project.comingSoon}
                image={project.image}
                imageAlt={project.imageAlt}
                priority={index === 0}
              />
            ))
          }
        </ul>
      </div>
    </section>

    <section class="about-teaser">
      <div class="wrap about-teaser__inner">
        <p class="italic-serif">
          I care most about the decisions behind the pixels &mdash; why a flow
          works, what it costs to build, and whether it actually helps the
          person using it.
        </p>
        <a class="view-link" href="/about">More about how I work &rarr;</a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .work-index {
    padding-block: var(--space-6);
  }

  .grid {
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .about-teaser {
    padding-block: var(--space-6);
    background: var(--ground-alt);
  }

  .about-teaser__inner {
    max-width: 46rem;
  }

  .about-teaser p {
    font-size: 1.5rem;
  }

  .about-teaser .view-link {
    display: inline-block;
    margin-top: var(--space-3);
    font-family: var(--font-body);
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent-tint);
  }

  .about-teaser .view-link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .about-teaser p {
      font-size: 1.25rem;
    }
  }
</style>
