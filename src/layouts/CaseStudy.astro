---
import Layout from './Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingDevice from '../components/FloatingDevice.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface CaseStudyImage {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

export interface CaseStudyBulletGroup {
  title?: string;
  items: { lead: string; text: string }[];
}

export interface CaseStudySection {
  id: string;
  navLabel: string;
  heading: string;
  body: string[];
  pullQuote?: string;
  images?: CaseStudyImage[];
  groups?: CaseStudyBulletGroup[];
  /** Render groups right after body copy (as the section's main content) instead
   *  of after the pull quote and images (as a closing list). */
  leadWithGroups?: boolean;
}

interface Props {
  title: string;
  slug: string;
  dek: string;
  role: string;
  timeline: string;
  team?: string;
  skills: string;
  gradient?: 'peach' | 'coral' | 'rose' | 'violet';
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  heroMockup?: boolean;
  sections: CaseStudySection[];
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
}

const {
  title,
  slug,
  dek,
  role,
  timeline,
  team,
  skills,
  gradient = 'coral',
  heroImage,
  heroImageAlt = '',
  heroMockup = false,
  sections,
  prev,
  next,
} = Astro.props;

const meta = [
  { label: 'Role', value: role },
  { label: 'Timeline', value: timeline },
  ...(team ? [{ label: 'Team', value: team }] : []),
  { label: 'Skills', value: skills },
];

// CSS-only current-section indicator: :target reflects the section the reader
// last jumped to via the sticky nav, styled through :has() rather than a
// scroll-spy script (the site ships zero client JS by default).
const sectionNavActiveCSS = sections
  .map((s) => `body:has(#${s.id}:target) .section-nav a[href="#${s.id}"] { color: var(--accent); }`)
  .join('\n');
---

<Layout title={`${title} — Megan`} description={dek}>
  <SiteNav />

  <main id="main-content">
    <header class="case-header">
      <div class="wrap">
        <a class="back-link cta cta--ghost" href="/work">&larr; All work</a>
        <h1>{title}</h1>
        <p class="dek">{dek}</p>
        <dl class="meta">
          {
            meta.map((item) => (
              <div class="meta-item">
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </header>

    <div class={`hero-panel hero-panel--${gradient}`} transition:name={`project-panel-${slug}`}>
      <div class="wrap hero-panel__inner">
        {
          heroMockup ? (
            <FloatingDevice width={300} height={545} image={heroImage} alt={heroImageAlt} priority mockup />
          ) : (
            <FloatingDevice width={200} height={320} image={heroImage} alt={heroImageAlt} priority />
          )
        }
      </div>
    </div>

    <style set:html={sectionNavActiveCSS}></style>

    <div class="wrap body-grid">
      <nav class="section-nav" aria-label="Case study sections">
        <ul>
          {
            sections.map((section) => (
              <li>
                <a href={`#${section.id}`}>{section.navLabel}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="sections">
        {
          sections.map((section) => {
            const ratios = section.images?.map((img) => img.src.width / img.src.height) ?? [];
            const hasExtremeRatio = ratios.some((r) => r < 0.5 || r > 2);
            const mismatchedPair =
              (ratios.length > 1 && Math.max(...ratios) / Math.min(...ratios) > 1.8) ||
              (ratios.length === 1 && hasExtremeRatio);
            return (
              <section id={section.id} class="case-section">
                <h2>{section.heading}</h2>
                {section.body.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                {section.leadWithGroups && section.groups && section.groups.length > 0 && (
                  <div class="section-groups">
                    {section.groups.map((group) => (
                      <div class="section-group">
                        {group.title && <h3>{group.title}</h3>}
                        <ul class="group-list">
                          {group.items.map((item) => (
                            <li><strong>{item.lead}:</strong> {item.text}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                )}
                {section.pullQuote && <blockquote class="pull-quote italic-serif">{section.pullQuote}</blockquote>}
                {section.images && section.images.length > 0 && (
                  <div class={section.images.length === 1 ? 'evidence-figures evidence-figures--single' : 'evidence-figures'}>
                    {section.images.map((img) => (
                      <figure class="evidence-figure" data-fit={mismatchedPair ? 'contain' : undefined}>
                        <Image
                          src={img.src}
                          alt={img.alt}
                          width={1200}
                          widths={[480, 800, 1200]}
                          sizes="(max-width: 800px) 100vw, 32rem"
                        />
                        {img.caption && <figcaption class="italic-serif">{img.caption}</figcaption>}
                      </figure>
                    ))}
                  </div>
                )}
                {!section.leadWithGroups && section.groups && section.groups.length > 0 && (
                  <div class="section-groups">
                    {section.groups.map((group) => (
                      <div class="section-group">
                        {group.title && <h3>{group.title}</h3>}
                        <ul class="group-list">
                          {group.items.map((item) => (
                            <li><strong>{item.lead}:</strong> {item.text}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                )}
              </section>
            );
          })
        }
      </div>
    </div>

    {
      (prev || next) && (
        <nav class="project-pagination" aria-label="Other projects">
          <div class="wrap pagination-row">
            {prev ? <a class="cta cta--ghost" href={`/work/${prev.slug}`}>&larr; {prev.title}</a> : <span />}
            {next ? <a class="cta" href={`/work/${next.slug}`}>{next.title} &rarr;</a> : <span />}
          </div>
        </nav>
      )
    }
  </main>

  <SiteFooter />
</Layout>

<style>
  .case-header {
    padding-block: var(--space-6) var(--space-4);
  }

  .back-link {
    padding: 0.7rem 1rem;
    font-size: 0.875rem;
    margin-bottom: var(--space-3);
  }

  .dek {
    margin-top: var(--space-2);
    font-size: 1.1875rem;
    color: var(--ink-soft);
    max-width: 54ch;
  }

  .meta {
    margin: var(--space-4) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .meta-item {
    min-width: 8rem;
  }

  .meta dt {
    font-size: 0.8125rem;
    color: var(--ink-faint);
  }

  .meta dd {
    margin: 0.2rem 0 0;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .hero-panel {
    border-radius: var(--radius-card);
    margin-inline: max(1.5rem, calc((100% - 74rem) / 2));
    box-shadow: var(--shadow-card);
    padding: var(--space-5) var(--space-3);
  }

  .hero-panel__inner {
    display: flex;
    justify-content: center;
  }

  .hero-panel--peach {
    background: radial-gradient(120% 100% at 20% 15%, var(--card-peach), var(--card-coral) 65%, var(--card-rose) 100%);
  }
  .hero-panel--coral {
    background: radial-gradient(120% 100% at 25% 10%, var(--card-coral), var(--card-rose) 70%, var(--card-violet) 100%);
  }
  .hero-panel--rose {
    background: radial-gradient(120% 100% at 20% 10%, var(--card-rose), var(--card-violet) 75%);
  }
  .hero-panel--violet {
    background: radial-gradient(120% 100% at 25% 10%, var(--card-violet), var(--card-rose) 70%, var(--card-coral) 100%);
  }

  .body-grid {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-5);
    padding-block: var(--space-6);
  }

  .section-nav {
    position: sticky;
    top: var(--space-3);
    align-self: start;
  }

  .section-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-left: 1px solid var(--ground-deep);
  }

  .section-nav a {
    display: block;
    padding: 0.7rem 0 0.7rem var(--space-2);
    font-size: 0.875rem;
    color: var(--ink-faint);
    text-decoration: none;
  }

  .section-nav a:hover {
    color: var(--accent);
  }

  .sections {
    display: grid;
    gap: var(--space-6);
  }

  .case-section p {
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }

  .pull-quote {
    font-size: 1.5rem;
    color: var(--ink);
    margin: var(--space-3) 0 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--ground-deep);
  }

  .section-groups {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .section-group h3 {
    max-width: none;
  }

  .group-list {
    max-width: var(--measure);
    margin: var(--space-2) 0 0;
    padding-left: 1.25rem;
    display: grid;
    gap: var(--space-1);
    color: var(--ink-soft);
  }

  .group-list li::marker {
    color: var(--ink-faint);
  }

  .group-list strong {
    color: var(--ink);
  }

  .evidence-figures {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  @media (max-width: 640px) {
    .evidence-figures {
      grid-template-columns: 1fr;
    }
  }

  /* A section with only one piece of evidence has no partner to fill the
     second grid column — stretching it to a lone left-aligned cell leaves a
     dead gap beside it, so it drops to one column and centers instead. */
  .evidence-figures--single {
    grid-template-columns: 1fr;
  }

  .evidence-figures--single .evidence-figure {
    max-width: 28rem;
    margin-inline: auto;
  }

  .evidence-figure {
    margin: 0;
  }

  .evidence-figure :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-media);
    box-shadow: var(--shadow-lift);
  }

  /* A pair whose source images differ too much in aspect ratio (e.g. a
     near-square storyboard next to a full-length phone wireframe), or a lone
     image with an extreme ratio on its own (e.g. a full-length phone
     screenshot), aligns by height instead of stretching to the column width —
     otherwise a tall image renders many times taller than is readable. */
  .evidence-figure[data-fit='contain'] {
    display: flex;
    flex-direction: column;
  }

  .evidence-figure[data-fit='contain'] :global(img) {
    align-self: center;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 34rem;
  }

  @media (max-width: 640px) {
    .evidence-figure[data-fit='contain'] :global(img) {
      max-height: none;
      width: 100%;
    }
  }

  .evidence-figure figcaption {
    margin-top: var(--space-1);
    font-size: 0.9375rem;
    color: var(--ink-faint);
  }

  .project-pagination {
    border-top: 1px solid var(--ground-deep);
    padding-block: var(--space-4);
  }

  .pagination-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .pagination-row .cta {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 30, 'SOFT' 35;
  }

  @media (max-width: 800px) {
    .body-grid {
      grid-template-columns: 1fr;
    }
    .section-nav {
      position: static;
      margin-bottom: var(--space-3);
    }
    .section-nav ul {
      display: flex;
      flex-wrap: wrap;
      border-left: none;
      border-top: 1px solid var(--ground-deep);
      padding-top: var(--space-2);
      gap: var(--space-3);
    }
    .section-nav a {
      padding-left: 0;
    }
  }
</style>
