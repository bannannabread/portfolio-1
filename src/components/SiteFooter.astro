---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap bar">
    <p class="credit">Designed by Megan &middot; {year}</p>
    <ul class="links">
      <li><a href="mailto:meganmae.jacob@gmail.com">Email</a></li>
      <li>
        <a href="https://www.linkedin.com/in/meganmaejacob/" rel="me noopener" target="_blank">LinkedIn</a>
      </li>
      <li><a href="https://github.com/bannannabread" rel="me noopener" target="_blank">GitHub</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-4) var(--space-5);
    border-top: 1px solid var(--ground-deep);
    margin-top: var(--space-7);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .credit {
    font-size: 0.875rem;
    color: var(--ink-faint);
    max-width: none;
  }

  .links {
    list-style: none;
    display: flex;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
  }

  .links a {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    padding-block: 0.7rem;
    margin-block: -0.7rem;
    border-bottom: 1px solid var(--ground-deep);
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
