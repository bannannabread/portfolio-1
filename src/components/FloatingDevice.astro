---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  width?: number;
  height?: number;
  image?: ImageMetadata;
  alt?: string;
}

const { width = 150, height = 260, image, alt = '' } = Astro.props;
---

<div class="floating-device" style={`--w:${width}px; --h:${height}px`}>
  <div class="device-face" aria-hidden={!image}>
    {image && <Image src={image} alt={alt} width={width * 2} class="device-img" />}
  </div>
  <div class="device-face reflection" aria-hidden="true">
    {image && <Image src={image} alt="" width={width * 2} class="device-img" />}
  </div>
</div>

<style>
  .floating-device {
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }

  .device-face {
    width: var(--w);
    height: var(--h);
    border-radius: 1.35rem;
    background: linear-gradient(155deg, #fffaf4 0%, var(--accent-tint) 100%);
    border: 1px solid rgba(36, 28, 23, 0.14);
    box-shadow: 0 1.25rem 1.5rem -0.75rem rgba(36, 28, 23, 0.35);
    overflow: hidden;
  }

  .device-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .reflection {
    margin-top: 0.4rem;
    height: calc(var(--h) * 0.55);
    transform: scaleY(-1);
    box-shadow: none;
    border-bottom: none;
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.32), transparent 85%);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.32), transparent 85%);
    opacity: 0.7;
  }
</style>
