---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  width?: number;
  height?: number;
  image?: ImageMetadata;
  alt?: string;
  priority?: boolean;
  mockup?: boolean;
}

const { width = 150, height = 260, image, alt = '', priority = false, mockup = false } = Astro.props;
const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : 'auto';
---

{
  mockup ? (
    <div class="floating-device floating-device--mockup" style={`--w:${width}px; --h:${height}px`}>
      {image && <Image src={image} alt={alt} width={width * 2} loading={loading} fetchpriority={fetchpriority} class="device-img" />}
    </div>
  ) : (
    <div class="floating-device" style={`--w:${width}px; --h:${height}px`}>
      <div class="device-face" aria-hidden={!image}>
        {image && <Image src={image} alt={alt} width={width * 2} loading={loading} fetchpriority={fetchpriority} class="device-img" />}
      </div>
      <div class="device-face reflection" aria-hidden="true">
        {image && <Image src={image} alt="" width={width * 2} loading={loading} fetchpriority={fetchpriority} class="device-img" />}
      </div>
    </div>
  )
}

<style>
  .floating-device {
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }

  .device-face {
    width: var(--w);
    height: var(--h);
    border-radius: 1.35rem;
    background: linear-gradient(155deg, #fffaf4 0%, var(--accent-tint) 100%);
    border: 1px solid rgba(36, 28, 23, 0.14);
    box-shadow: 0 1.25rem 1.5rem -0.75rem rgba(36, 28, 23, 0.35);
    overflow: hidden;
  }

  .device-face .device-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .reflection {
    margin-top: 0.4rem;
    height: calc(var(--h) * 0.22);
    transform: scaleY(-1);
    box-shadow: none;
    border-bottom: none;
    filter: blur(3px);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.25), transparent 60%);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.25), transparent 60%);
    opacity: 0.45;
  }

  .floating-device--mockup {
    width: var(--w);
    max-width: 100%;
    aspect-ratio: var(--w) / var(--h);
    height: auto;
    align-items: center;
    justify-content: center;
  }

  .floating-device--mockup .device-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
</style>
