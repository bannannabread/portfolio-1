---
import FloatingDevice from './FloatingDevice.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  href?: string;
  slug?: string;
  gradient?: 'peach' | 'coral' | 'rose' | 'violet';
  title?: string;
  caption?: string;
  tags?: string[];
  comingSoon?: boolean;
  image?: ImageMetadata;
  imageAlt?: string;
  priority?: boolean;
}

const {
  href,
  slug,
  gradient = 'coral',
  title,
  caption,
  tags = [],
  comingSoon = false,
  image,
  imageAlt = '',
  priority = false,
} = Astro.props;

const comingSoonText = title ? `${title} — coming soon.` : 'New case study — coming soon.';
const panelTransitionName = !comingSoon && slug ? `project-panel-${slug}` : undefined;
---

<li class="card-item">
  <div class={`panel panel--${gradient} ${comingSoon ? 'panel--empty' : ''}`} transition:name={panelTransitionName}>
    {
      comingSoon ? (
        <svg class="device-ghost" width="216" height="391" viewBox="0 0 216 391" fill="none" aria-hidden="true">
          <rect x="4" y="4" width="208" height="383" rx="32" stroke="currentColor" stroke-width="2" stroke-dasharray="4 6" />
        </svg>
      ) : (
        <>
          <ul class="tag-scatter" aria-hidden="true">
            {tags.slice(0, 4).map((tag, i) => (
              <li class={`tag-pill tag-pill--${i}`} style={`--stagger: ${i}`}>
                {tag}
              </li>
            ))}
          </ul>
          <div class="device-wrap">
            <FloatingDevice width={254} height={460} image={image} alt={imageAlt} priority={priority} mockup />
          </div>
        </>
      )
    }
  </div>

  {
    comingSoon ? (
      <p class="caption caption--muted italic-serif">{comingSoonText}</p>
    ) : (
      <p class="caption italic-serif">{caption}</p>
    )
  }

  {
    !comingSoon && tags.length > 0 && (
      <p class="tag-row">{tags.join(' · ')}</p>
    )
  }

  {
    !comingSoon && href && (
      <a class="view-link" href={href}>
        View case study <span aria-hidden="true">&rarr;</span>
      </a>
    )
  }
</li>

<style>
  .card-item {
    list-style: none;
  }

  .panel {
    border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 33rem;
    box-shadow: var(--shadow-card);
    position: relative;
    z-index: 0;
    overflow: hidden;
    margin-bottom: var(--space-3);
  }

  .panel::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 45%;
    background: linear-gradient(to top, rgba(36, 28, 23, 0.14), transparent);
    pointer-events: none;
  }

  .panel--peach {
    background: radial-gradient(120% 100% at 20% 15%, var(--card-peach), var(--card-coral) 65%, var(--card-rose) 100%);
  }
  .panel--coral {
    background: radial-gradient(120% 100% at 25% 10%, var(--card-coral), var(--card-rose) 70%, var(--card-violet) 100%);
  }
  .panel--rose {
    background: radial-gradient(120% 100% at 20% 10%, var(--card-rose), var(--card-violet) 75%);
  }
  .panel--violet {
    background: radial-gradient(120% 100% at 25% 10%, var(--card-violet), var(--card-rose) 70%, var(--card-coral) 100%);
  }

  .device-wrap {
    position: relative;
    z-index: 2;
    min-width: 0;
    max-width: 100%;
    transition: transform 0.4s var(--ease-out);
  }

  .card-item:hover .device-wrap {
    transform: translateY(-0.35rem);
  }

  .tag-scatter {
    position: absolute;
    inset: 0;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    pointer-events: none;
  }

  .tag-pill {
    position: absolute;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    box-shadow: var(--shadow-lift);
    white-space: nowrap;
    opacity: 0;
    transform: translate(var(--tuck-x), var(--tuck-y)) scale(0.75) rotate(0deg);
    transition: opacity 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }

  .card-item:hover .tag-pill {
    opacity: 1;
    transform: translate(0, 0) scale(1) rotate(var(--rest-rotate, 0deg));
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
    transition-delay: calc(var(--stagger, 0) * 50ms);
    will-change: transform, opacity;
  }

  .tag-pill--0 {
    top: 1.75rem;
    left: 1.5rem;
    --tuck-x: 3rem;
    --tuck-y: 3.5rem;
    --rest-rotate: -7deg;
  }

  .tag-pill--1 {
    top: 2.75rem;
    right: 1.25rem;
    --tuck-x: -3rem;
    --tuck-y: 4rem;
    --rest-rotate: 5deg;
  }

  .tag-pill--2 {
    bottom: 3.5rem;
    left: 1rem;
    --tuck-x: 2.5rem;
    --tuck-y: -4rem;
    --rest-rotate: 4deg;
  }

  .tag-pill--3 {
    bottom: 2rem;
    right: 1.75rem;
    --tuck-x: -3rem;
    --tuck-y: -3rem;
    --rest-rotate: -5deg;
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-pill {
      transition: opacity 0.15s linear;
      transform: none;
    }

    .card-item:hover .tag-pill {
      transform: none;
      transition-delay: 0ms;
    }
  }

  .panel--empty {
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--card-peach) 20%, var(--ground-alt)),
      color-mix(in srgb, var(--card-rose) 16%, var(--ground-alt))
    );
    box-shadow: none;
    border: 1px solid var(--ground-deep);
  }

  .panel--empty::after {
    display: none;
  }

  .device-ghost {
    color: var(--ink-faint);
  }

  .caption {
    font-size: 1.25rem;
    max-width: 32ch;
    color: var(--ink);
  }

  .caption--muted {
    color: var(--ink-faint);
  }

  .tag-row {
    margin-top: var(--space-1);
  }

  .view-link {
    display: inline-block;
    margin-top: var(--space-2);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent-tint);
  }

  .view-link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .view-link span {
    display: inline-block;
    transition: transform 0.2s var(--ease-out);
  }

  .view-link:hover span {
    transform: translateX(0.2em);
  }
</style>
